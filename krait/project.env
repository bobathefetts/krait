# Krait's names, in one place.  CMakeLists.txt (target and binary names; the binaries print the name they are built
# with), krait/build.sh, krait/krait and docker/krait/stage.sh (image tag) read this file.  Plain KEY=value lines only
# (shell and CMake both parse them).  Text that cannot read it (docs, compose.yml, config.json "exe") names them too.
PROJECT_NAME="Krait"
PROJECT_SLUG=krait
ENGINE_BIN=krait-engine
LAYOUT_BIN=krait-layout
VECDOT_BIN=krait-vecdot-test
VISION_BIN=krait-vision
