#!/usr/bin/env bash
# krait: starts the server (OpenAI /v1/chat/completions, Anthropic /v1/messages, the web page) on Nemotron 3.5 Super
# (ENGINE_BIN in krait/project.env).  Paths in the config are relative to KRAIT_ROOT, the directory that holds build/, models/ and pack/
# (default: three levels above this script, the port's work directory).
#   KRAIT_ROOT=<dir>  KRAIT_PYTHON=<python>  KRAIT_CONFIG=<json>  KRAIT_API_KEY=<key>  PORT=8095  HOST=127.0.0.1
#   krait/krait [server options, e.g. --api-key, --help]
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
. "$HERE/project.env"
KRAIT_ROOT="${KRAIT_ROOT:-$(cd "$REPO/../.." && pwd)}"
CFG="${KRAIT_CONFIG:-$HERE/config.json}"
PY="${KRAIT_PYTHON:-}"
if [ -z "$PY" ]; then
  if [ -x "$KRAIT_ROOT/env/dl/bin/python3" ]; then PY="$KRAIT_ROOT/env/dl/bin/python3"; else PY=python3; fi
fi
# the server (upstream Strata's serve/server.py) reads its key from STRATA_API_KEY
if [ -n "${KRAIT_API_KEY+x}" ]; then export STRATA_API_KEY="$KRAIT_API_KEY"; fi
cd "$KRAIT_ROOT"
mkdir -p logs
for f in "build/krait/$ENGINE_BIN" pack/nemotron/tokenizer/tokenizer.json; do
  [ -e "$f" ] || { echo "krait: $KRAIT_ROOT/$f is missing" >&2; exit 1; }
done
exec "$PY" "$REPO/serve/server.py" --engine strata --config "$CFG" \
  --host "${HOST:-127.0.0.1}" --port "${PORT:-8095}" "$@"
