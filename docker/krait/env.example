# copy to docker/krait/.env and fill in.  Keys: long random strings, e.g. from  openssl rand -hex 24
# (the server refuses placeholder keys that start with change-me).
KRAIT_MODELS=/path/to/models            # holds UD-Q4_K_XL/, mmproj-BF16.gguf, embed/nomic-embed-text-v1.5.Q8_0.gguf
KRAIT_API_KEY=                          # Open WebUI uses it; so do your own clients on 127.0.0.1:8095
EMBED_API_KEY=
WEBUI_SECRET_KEY=
# extra engine flags for this machine, e.g. a VRAM cap on a card that also drives a desktop:
# KRAIT_ENGINE_ARGS=--vram-limit-mib 29346
# KRAIT_PORT=8095
# WEBUI_PORT=3095
# EMBED_PORT=8096
# EMBED_THREADS=4
