# copy to docker/nemotron/.env and fill in
NH_MODELS=/path/to/models            # holds UD-Q4_K_XL/, mmproj-BF16.gguf, embed/nomic-embed-text-v1.5.Q8_0.gguf
STRATA_API_KEY=change-me             # Open WebUI uses it; so do your own clients on 127.0.0.1:8095
EMBED_API_KEY=change-me-too
WEBUI_SECRET_KEY=change-me-three
